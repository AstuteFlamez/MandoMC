# Runtime, local tools, downloaded assets, credentials and old snapshots
.runtime/
.local/
reference/
.env
.env.*
!.env.example
# Builds and editor state
**/target/
**/build/
**/.gradle/
.idea/
*.iml
.DS_Store
# Binary artifacts are managed outside source control
*.jar
*.zip
*.log
*.db
*.db-shm
*.db-wal

# Per-machine editor/JDK settings
.vscode/settings.json

# Runnable local server: worlds, plugins, generated settings and EULA
server/runtime/

# Python tool caches
__pycache__/
*.py[cod]

# Only source-controlled setup files belong directly under server/.
# This also excludes commissioned worlds with arbitrary folder names.
/server/*
!/server/README.md
!/server/start.command
!/server/paper.lock.json
!/server/plugins.lock.json
!/server/plugins.catalog.json
!/server/config/
# Never track installed plugins or world payloads, even inside config subfolders.
/server/**/plugins/
/server/**/worlds/
/server/**/region/
/server/**/entities/
/server/**/poi/
/server/**/playerdata/
/server/**/advancements/
/server/**/stats/
/server/**/DIM*/
/server/**/dimensions/
/server/**/level.dat*
/server/**/uid.dat
/server/**/session.lock
/server/**/*.mca
/server/**/*.mcc
