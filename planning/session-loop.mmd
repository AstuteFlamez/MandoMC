flowchart LR
  start["Returning player session"] --> goal{"Choose session goal"}
  goal -->|"Build"| build["Expand base + stockpile"]
  goal -->|"Supply"| gather["Gather materials + credits"]
  goal -->|"Event active"| event["KOTH or Jabba"]
  gather --> equip["Craft or buy gear"]
  equip --> expedition["Explore + gather + fight"]
  event --> outcome{"Survive?"}
  expedition --> outcome
  outcome -->|"Yes"| bank["Return with loot"]
  bank --> build
  outcome -->|"No: confirmed rule"| death["Drop all carried items"]
  death --> stockpile{"Stored equipment available?"}
  stockpile -->|"Yes"| recover["Re-equip from base supplies"]
  stockpile -->|"No"| gather
  recover --> goal
  death -.->|"Killed by an opposing group in event PvP"| warpoints["Rivalry score: victim -1, killer +1"]
  warpoints --> vulnerable["A sufficient net-kill lead permits that rival to breach, including offline"]
  build --> next["Choose next goal"]
  next -.-> start
  style gather fill:#FFECBD,stroke:#FFC943
  style equip fill:#FFECBD,stroke:#FFC943
  style recover fill:#FFECBD,stroke:#FFC943
  style death fill:#C2E5FF,stroke:#3DADFF
