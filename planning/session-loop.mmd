flowchart LR
  start["Log in at base"] --> goal{"Choose session goal"}
  goal -->|"Build"| build["Expand base + stockpile"]
  goal -->|"Supply"| gather["Gather materials + credits"]
  goal -->|"Event active"| event["KOTH or Jabba"]
  gather --> equip["Craft or buy gear"]
  equip --> expedition["Explore + gather + fight"]
  event --> outcome{"Survive?"}
  expedition --> outcome
  outcome -->|"Yes"| bank["Return with loot"]
  bank --> build
  outcome -->|"No: confirmed rule"| death["Drop all carried items"]
  death --> recover["Equip replacement loadout"]
  recover --> goal
  build --> next["Choose next goal"]
  next -.-> start
  style gather fill:#FFECBD,stroke:#FFC943
  style equip fill:#FFECBD,stroke:#FFC943
  style recover fill:#FFECBD,stroke:#FFC943
