[Unit]
Description=MandoMC Discord Gateway companion
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mandomc-bot
WorkingDirectory=/opt/mandomc/discord-bot/gateway
EnvironmentFile=/etc/mandomc-discord.env
ExecStart=/opt/mandomc/discord-bot/gateway/.venv/bin/python companion.py
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
